@model Book
@{
    ViewData["Title"] = Model.Title;
}

<div class="breadcrumb">
    <a asp-action="Index">Повернутися до каталогу</a>
</div>

<section class="book-details-card">
    <div class="details-gallery">
        @if (Model.Images.Any())
        {
            <div class="main-image-box">
                <img id="activeBookImage" src="@Model.Images.First().ImageUrl" alt="@Model.Title" />
            </div>
            <div class="thumbnails-row">
                @foreach (var img in Model.Images)
                {
                    <img src="@img.ImageUrl"
                         alt="Обкладинка @Model.Title"
                         class="thumb-img"
                         onclick="document.getElementById('activeBookImage').src = this.src" />
                }
            </div>
        }
        else
        {
            <p>Зображення відсутні.</p>
        }

        <form asp-action="AddImages" method="post" class="mini-upload-form">
            <input type="hidden" name="bookId" value="@Model.Id" />
            <label for="moreUrls">Додати ще посилання на фото (кожне з нового рядка):</label>
            <textarea id="moreUrls" name="imageUrlsRaw" rows="2" placeholder="https://covers.openlibrary.org/b/isbn/...-L.jpg" required></textarea>
            <button type="submit" class="btn-outline btn-small">Додати фото</button>
        </form>
    </div>

    <div class="details-content">
        <span class="badge-genre-inline">@Model.Genre</span>
        <h1>@Model.Title</h1>
        <p class="details-author">Автор: <strong>@Model.Author</strong></p>
        <p class="details-price">@Model.Price.ToString("0.00") грн</p>
        <div class="details-description">
            <h3>Опис книги</h3>
            <p>@Model.Description</p>
        </div>
    </div>
</section>

<section class="comments-section">
    <h2>Коментарі читачів (@Model.Comments.Count)</h2>

    <form asp-action="AddComment" method="post" class="comment-form">
        <input type="hidden" name="bookId" value="@Model.Id" />
        <div class="form-group">
            <label for="userName">Ваше ім'я:</label>
            <input type="text" id="userName" name="userName" required placeholder="Введіть ваше ім'я" />
        </div>
        <div class="form-group">
            <label for="text">Ваш коментар:</label>
            <textarea id="text" name="text" rows="3" required placeholder="Поділіться враженнями про книгу..."></textarea>
        </div>
        <button type="submit" class="btn-accent">Опублікувати коментар</button>
    </form>

    <div class="comments-list">
        @if (!Model.Comments.Any())
        {
            <p class="no-comments">Поки що немає коментарів.</p>
        }
        else
        {
            @foreach (var comment in Model.Comments)
            {
                <div class="comment-item">
                    <div class="comment-header">
                        <strong class="comment-author">@comment.UserName</strong>
                        <span class="comment-date">@comment.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                    <p class="comment-body">@comment.Text</p>
                </div>
            }
        }
    </div>
</section>