@model IEnumerable<BookStoreApp.Components.GenreStatItem>

<div class="genre-bar">
    <span class="genre-label">Жанри:</span>
    <a asp-controller="Home" asp-action="Index" asp-route-genre=""
       class="genre-pill @(string.IsNullOrEmpty(ViewBag.SelectedGenre) ? "active" : "")">
        Усі книги (@ViewBag.TotalCount)
    </a>
    @foreach (var item in Model)
    {
        <a asp-controller="Home" asp-action="Index" asp-route-genre="@item.Genre"
           class="genre-pill @(ViewBag.SelectedGenre == item.Genre ? "active" : "")">
            @item.Genre (@item.Count)
        </a>
    }
</div>