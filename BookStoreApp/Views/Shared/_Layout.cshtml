<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Книгарня</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container header-inner">
            <a asp-controller="Home" asp-action="Index" class="brand-title">Книгарня</a>
            <nav class="main-nav">
                <a asp-controller="Home" asp-action="Index" class="nav-link">Каталог книг</a>
                <a asp-controller="Home" asp-action="Create" class="btn-accent">Додати книгу</a>
            </nav>
        </div>
    </header>

    <main class="container main-content">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <p>Онлайн-магазин книг &copy; 2026. Усі права захищено.</p>
        </div>
    </footer>
</body>
</html>
